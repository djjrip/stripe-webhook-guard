{
  "name": "stripe-webhook-guard",
  "version": "1.1.0",
  "type": "module",
  "description": "Experimental Stripe webhook signature helper, in-memory idempotency store, and source-pattern audit heuristics for Node.js and TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "stripe-webhook-guard": "./bin/cli.js"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "test": "node ./node_modules/typescript/bin/tsc -p tsconfig.test.json && node dist/tests/guard.test.js",
    "start": "node bin/cli.js"
  },
  "keywords": [
    "stripe",
    "webhooks",
    "idempotency",
    "postgresql",
    "retry-handling",
    "payments",
    "microservices",
    "typescript",
    "cli"
  ],
  "author": "Jayson Quindao <jquindao1@icloud.com> (https://djjrip.github.io/gaming-for-groceries/)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
